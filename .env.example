NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Shared API/Worker infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cvg_his
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=cvg-his

# API auth (required)
# Gere com: openssl rand -hex 32
JWT_SECRET=replace_with_real_secret
JWT_ISSUER=cvg-his
JWT_AUDIENCE=cvg-his-api

# Worker runtime
HANDOVER_STORAGE_DIR=/tmp/cvg-his-storage

# API Key authentication (optional - requer API_KEY e API_KEY_ACCOUNT_ID definidos)
# A chave deve ter no mínimo 32 caracteres
# API_KEY=your-api-key-minimum-32-chars-here
# API_KEY_ACCOUNT_ID=<uuid-do-account-associado-a-esta-chave>

# =============================================================================
# his-web (Next.js frontend) environment variables
# =============================================================================
# PUBLIC (client-side): Must be "/api/proxy" - the proxy route
NEXT_PUBLIC_HIS_API_BASE_URL=/api/proxy

# SERVER-SIDE (proxy route): Internal URL to reach his-api
# Required in production. Example: http://his-api:3000
HIS_API_INTERNAL_URL=http://localhost:3000

# Auth cookie settings
HIS_AUTH_COOKIE_DOMAIN=
HIS_AUTH_COOKIE_MAX_AGE_SECONDS=28800
# auto = usa https quando vier por proxy/TLS; false permite teste direto por HTTP/IP
HIS_AUTH_COOKIE_SECURE=auto

# =============================================================================
# Qdrant (optional - for protocol search)
# =============================================================================
QDRANT_URL=
QDRANT_COLLECTION=professor
QDRANT_API_KEY=
