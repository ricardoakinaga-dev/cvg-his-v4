NEXT_PUBLIC_APP_NAME="CVG HIS"

# The Next.js API client mode.
# - proxy: routes fetch calls to /api/backend (same origin), avoiding CORS
# - direct: uses NEXT_PUBLIC_API_BASE_URL to call the backend directly
NEXT_PUBLIC_API_MODE="proxy"

# When using proxy mode, Next.js will forward requests to this internal URL
HIS_API_INTERNAL_URL="http://127.0.0.1:3000"

# When using direct mode, this is the exposed backend URL
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:3000"
