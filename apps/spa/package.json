{
  "name": "@cvg-his-v2/spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "node ./scripts/prebuild-clean.cjs && vue-tsc --noEmit && vite build",
    "build:pwa": "node ./scripts/prebuild-clean.cjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 3002",
