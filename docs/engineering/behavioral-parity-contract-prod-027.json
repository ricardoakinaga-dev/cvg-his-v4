      "expected": "O inventário observado bate o filesystem; a diferença 45→46 fica aberta e workflows não é descartado.",
      "evidence": "Manifesto de diretórios + known-bad de módulo ausente/duplicado."
    },
    {
      "id": "SCN-003",
      "kind": "positive",
      "case": "Uma jornada válida da área é executada na fronteira pública com fixture sintética.",
      "expected": "Resultado, estado persistido e evidência correspondem ao contrato da área.",
      "evidence": "API/UI/DB/processo aplicável + fixture digest-bound."
    },
    {
      "id": "SCN-004",
      "kind": "negative",
      "case": "Entrada inválida, transição impossível ou provider rejeita a operação.",
      "expected": "Negação segura, erro acionável e ausência de efeito parcial.",
      "evidence": "Teste negativo e reconciliação."
    },
    {
      "id": "SCN-005",
      "kind": "permission",
      "case": "Perfis, tenant, flags e escopos tentam ler ou mutar fora da autorização.",
      "expected": "Acesso indevido é negado e nenhum dado/efeito cruza tenant.",
      "evidence": "Matriz de permissão + prova multi-tenant."
    },
    {
      "id": "SCN-006",
      "kind": "persistence",
      "case": "A jornada é recarregada ou o processo reiniciado após efeito parcial.",
      "expected": "Estado durável, autoria, versão e retomada são coerentes.",
      "evidence": "API/DB/processo e timeline de restart."
    },
    {
      "id": "SCN-007",
      "kind": "reconciliation",
      "case": "A saída é comparada ao ledger, fonte, subledger ou documento de referência.",
      "expected": "Contagens, valores, relações e status reconciliam; divergência abre finding.",
      "evidence": "Dataset oracle aprovado + relatório de reconciliação."
    },
    {
      "id": "SCN-008",
      "kind": "concurrency",
      "case": "Duas solicitações concorrentes/replay/timeout incidem sobre o mesmo recurso quando aplicável.",
      "expected": "Locks/idempotência/ordem preservam invariantes sem duplicação.",
      "evidence": "Teste concorrente em stack privada, sem reduzir casos."
    },
    {
      "id": "SCN-009",
      "kind": "vetus-unknown",
      "case": "Manifesto, implementação atual e referência Vetus divergem ou não cobrem a regra.",
      "expected": "Estado fica UNKNOWN/BLOCKED e exige decisão; não se infere equivalência por nome de menu.",
      "evidence": "Crosswalk com lacuna e owner de domínio."
    },
    {
      "id": "SCN-010",
      "kind": "commercial",
