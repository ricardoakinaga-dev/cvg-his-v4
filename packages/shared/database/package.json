{
  "name": "@cvg-his-v2/shared-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/tenant-authorization-lock.test.ts src/tenant-transaction-context.test.ts",
    "db:generate": "node ../../../scripts/reject-legacy-db-command.mjs @cvg-his-v2/shared-database:generate",
    "db:migrate": "node ../../../scripts/reject-legacy-db-command.mjs @cvg-his-v2/shared-database:migrate",
    "db:push": "node ../../../scripts/reject-legacy-db-command.mjs @cvg-his-v2/shared-database:push"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
