{
  "name": "@cvg-his/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/**/*.d.ts\"",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b tsconfig.json --force",
    "db:generate": "node ../../scripts/reject-legacy-db-command.mjs @cvg-his/db:generate",
    "db:push": "node ../../scripts/reject-legacy-db-command.mjs @cvg-his/db:push",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@cvg-his-v2/rbac": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
