{
  "name": "@cvg-his-v2/module-soc2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../../.. && vitest run packages/modules/soc2/src/*.test.ts"
  },
  "dependencies": {
    "@cvg-his-v2/shared-types": "workspace:*",
    "@cvg-his-v2/shared-utils": "workspace:*",
    "@cvg-his-v2/shared-database": "workspace:*",
    "@cvg-his-v2/shared-errors": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
