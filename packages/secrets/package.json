{
  "name": "@cvg-his-v2/secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    }
  },
  "dependencies": {
    "@cvg-his-v2/shared-errors": "workspace:*",
    "@cvg-his-v2/shared-logging": "workspace:*",
    "@cvg-his-v2/shared-validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
