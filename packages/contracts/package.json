{
  "name": "@cvg-his/contracts",
  "version": "1.0.0",
  "description": "Shared API contracts for CVG HIS - Contract Gate to prevent drift between his-web and his-api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./owners": {
      "import": "./dist/owners.js",
      "types": "./dist/owners.d.ts"
    },
    "./patients": {
      "import": "./dist/patients.js",
      "types": "./dist/patients.d.ts"
    },
    "./encounters": {
      "import": "./dist/encounters.js",
      "types": "./dist/encounters.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  }
}
