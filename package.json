{
  "name": "cvg-his-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.45.2",
      "@babel/core": "^7.29.7",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@grpc/grpc-js": "1.14.4",
      "@opentelemetry/core": "2.10.0",
      "@opentelemetry/propagator-jaeger": "2.10.0",
      "protobufjs": "^7.6.5",
      "@protobufjs/utf8": "^1.1.1",
      "fast-uri": "^3.1.5",
      "flatted": "^3.4.2",
      "js-cookie": "^3.0.7",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "picomatch@4.0.3": "4.0.4",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "esbuild@0.27.3": "0.28.2",
      "js-yaml": "^4.3.1",
      "nanoid": "3.3.18",
      "postcss": "^8.5.26",
      "rollup@4.57.1": "4.60.4",
      "serialize-javascript": "^7.0.5",
      "shell-quote": "^1.10.0",
      "undici": "^7.29.0",
      "vite": "6.4.3",
      "ws": "^8.20.1",
      "vue-component-type-helpers": "3.2.7",
      "ajv@6.12.6": "6.14.0",
      "esbuild@0.18.20": "0.25.12",
      "esbuild@0.19.12": "0.25.12"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cvg-his-v2/api --filter @cvg-his-v2/spa --filter @cvg-his-v2/worker run dev",
    "dev:api": "pnpm --filter @cvg-his-v2/api run dev",
    "dev:spa": "pnpm --filter @cvg-his-v2/spa run dev",
    "dev:worker": "pnpm --filter @cvg-his-v2/worker run dev",
    "build": "pnpm -r --filter @cvg-his-v2/* run build",
    "typecheck": "pnpm -r --filter @cvg-his-v2/* run typecheck",
    "lint": "pnpm -r --filter @cvg-his-v2/* run lint",
    "test": "pnpm -r --filter @cvg-his-v2/* run test",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e && pnpm test:e2e:spa:functional",
    "test:smoke": "bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts --grep-invert \"Visual\"'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "vitest run tests/integration/database --config vitest.integration.config.ts",
    "test:critical": "REQUIRE_TEST_DB=1 vitest run tests/integration/database/*.test.ts tests/integration/foundational.test.ts --config vitest.integration.config.ts --reporter=verbose",
    "test:runner:clean": "node infra/scripts/cleanup-test-runner.mjs --kill-orphans --drop-stale-dbs",
    "test:critical:bootstrap": "node infra/scripts/test-critical-bootstrap.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "node --test scripts/e2e-workflow.test.mjs && npx playwright test --config playwright.config.ts",
    "test:e2e:spa": "node --test scripts/e2e-workflow.test.mjs && bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts'",
    "test:e2e:spa:functional": "node --test scripts/e2e-workflow.test.mjs && bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts --grep-invert \"Visual\"'",
    "test:e2e:spa:360": "node --test scripts/e2e-workflow.test.mjs && bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts e2e/spa/master-search-360-reception.spec.ts e2e/spa/master-search-360-mobile.spec.ts'",
    "test:e2e:spa:enterprise": "node --test scripts/e2e-workflow.test.mjs && bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts e2e/spa/master-search-360-reception.spec.ts e2e/spa/master-search-360-mobile.spec.ts e2e/spa/enterprise-surfaces-gate.spec.ts'",
    "readiness:enterprise": "node scripts/check-enterprise-readiness.mjs",
    "test:e2e:spa:headed": "npx playwright test --config playwright-spa.config.ts --headed",
    "test:e2e:spa:docker": "bash infra/scripts/run-e2e-spa.sh",
    "test:e2e:spa:docker:keep": "bash infra/scripts/run-e2e-spa.sh --no-cleanup",
    "test:visual": "node --test scripts/e2e-workflow.test.mjs && bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts -g \"Visual\"'",
    "test:visual:update": "bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts -g \"Visual\" --update-snapshots'",
    "test:visual:headed": "npx playwright test --config playwright-spa.config.ts -g \"Visual\" --headed",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d --force-recreate postgres-test",
    "test:db:stop": "docker compose -f docker-compose.test.yml down -v",
    "benchmark:k6:seed": "pnpm exec tsx benchmarks/k6/seed-benchmark-fixtures.ts",
    "benchmark:k6": "k6 run benchmarks/k6/api-benchmark.js",
    "benchmark:k6:parse": "node benchmarks/k6/parse-results.js benchmarks/k6/results/performance-report.json",
    "release:check": "flock -w 1800 /tmp/cvg-his-v2-release-check.lock -c 'pnpm deploy:check && pnpm build && pnpm test:coverage && pnpm test:e2e:spa:docker'",
    "bootstrap": "node infra/scripts/bootstrap-local.mjs",
    "ops:backup:v2": "bash infra/scripts/backup-v2.sh",
    "ops:backup:check": "node infra/scripts/validate-backup-restore.mjs",
    "ops:restore:fixture": "node infra/scripts/create-restore-drill-fixture.mjs",
    "ops:restore:drill:fixture": "node infra/scripts/run-restore-drill-fixture.mjs",
    "ops:restore:drill:v2": "bash infra/scripts/restore-drill-v2.sh",
    "staging:bootstrap": "node infra/scripts/bootstrap-local.mjs",
    "staging:check": "node infra/scripts/check-staging.mjs",
    "turbo:build": "PATH=./node_modules/.bin:.:$PATH turbo run build --filter=@cvg-his-v2/*",
    "turbo:typecheck": "PATH=./node_modules/.bin:.:$PATH turbo run typecheck --filter=@cvg-his-v2/*",
    "guardrail:ds-imports": "bash scripts/check-legacy-ds-imports.sh",
    "governance:access": "node scripts/generate-access-governance-evidence.mjs",
    "governance:audit": "node scripts/generate-audit-governance-evidence.mjs",
    "governance:lgpd": "node scripts/generate-lgpd-governance-evidence.mjs",
    "governance:observability": "node scripts/generate-observability-governance-evidence.mjs",
    "security:secrets": "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore \".env*.example\" \"*.{md,json,yml,yaml,toml}\" \".github/**/*.{yml,yaml}\" \"apps/**/*.{ts,tsx,js,jsx,mjs,cjs,vue,json,yml,yaml}\" \"packages/**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml}\" \"infra/**/*.{ts,js,mjs,cjs,yml,yaml,md}\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"docs/**/*.md\" \"docker-compose*.yml\"",
    "security:enterprise": "node scripts/run-security-audit.mjs",
    "security:evidence": "node scripts/generate-security-evidence.mjs",
    "security:sbom": "node scripts/generate-cyclonedx-sbom.mjs",
    "security:sbom:validate": "node scripts/validate-cyclonedx-sbom.mjs",
    "security:semgrep:gate": "node scripts/gate-semgrep-results.mjs",
    "security:gitleaks:gate": "node scripts/gate-gitleaks-results.mjs",
    "security:trivy:gate": "node scripts/gate-trivy-results.mjs",
    "security:ci:test": "node --test scripts/container-hardening.test.mjs scripts/smoke-container-image.test.mjs scripts/gate-semgrep-results.test.mjs scripts/gate-gitleaks-results.test.mjs scripts/gate-trivy-results.test.mjs scripts/validate-cyclonedx-sbom.test.mjs scripts/security-workflow.test.mjs",
    "cutover:check": "node infra/scripts/check-cutover-readiness.mjs",
    "deploy:check": "node infra/scripts/check-cutover-readiness.mjs",
    "deploy:rehearsal:local": "node infra/scripts/cutover-rehearsal-local.mjs",
    "deploy:cutover:v2": "bash infra/scripts/cutover-v2.sh",
    "validate:openapi": "node scripts/validate-openapi.js",
    "validate:rls": "tsx scripts/validate-rls-coverage.ts",
    "db:runtime-role:provision": "node scripts/provision-database-runtime-role.mjs",
    "validate:database-role": "node scripts/provision-database-runtime-role.mjs --validate-only",
    "test:database-role-script": "node --test scripts/database-bootstrap.test.mjs scripts/provision-database-runtime-role.test.mjs",
    "validate:helm": "node infra/scripts/validate-helm.mjs",
    "vetus:parity": "node --test scripts/check-vetus-parity.test.mjs && node scripts/check-vetus-parity.mjs",
    "vetus:clinical-parity": "node scripts/check-vetus-clinical-parity.mjs",
    "rc:evidence": "node scripts/generate-enterprise-rc-evidence.mjs",
    "rc:evidence:strict": "node scripts/generate-enterprise-rc-evidence.mjs --strict"
  },
  "description": "Monorepo do sistema HIS veterinário versão 2, construido em padrão Enterprise.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardoakinaga-dev/cvg-his-v2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ricardoakinaga-dev/cvg-his-v2/issues"
  },
  "homepage": "https://github.com/ricardoakinaga-dev/cvg-his-v2#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@secretlint/secretlint-rule-preset-recommend": "^11.6.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.15.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "prettier": "^3.5.1",
    "secretlint": "^11.6.0",
    "tsx": "^4.23.12",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6",
    "yaml": "^2.8.3"
  }
}
