{
  "name": "cvg-his-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cvg-his-v2/api --filter @cvg-his-v2/web --filter @cvg-his-v2/worker run dev",
    "dev:api": "pnpm --filter @cvg-his-v2/api run dev",
    "dev:web": "pnpm --filter @cvg-his-v2/web run dev",
    "dev:worker": "pnpm --filter @cvg-his-v2/worker run dev",
    "build": "pnpm -r --filter @cvg-his-v2/* run build",
    "typecheck": "pnpm -r --filter @cvg-his-v2/* run typecheck",
    "lint": "pnpm -r --filter @cvg-his-v2/* run lint",
    "test": "pnpm -r --filter @cvg-his-v2/* run test",
    "test:all": "pnpm test:critical && pnpm test:e2e",
    "test:smoke": "npx playwright test --config e2e/playwright-smoke.config.ts",
    "test:integration": "vitest run tests/integration --config vitest.config.ts",
    "test:db": "vitest run tests/integration/database --config vitest.config.ts",
    "test:critical": "REQUIRE_TEST_DB=1 DATABASE_URL_TEST=\"postgres://postgres:postgres@localhost:5433/cvg_his_v2_test\" DATABASE_URL=\"postgres://postgres:postgres@localhost:5433/cvg_his_v2_test\" vitest run tests/integration/database tests/integration/foundational.test.ts --config vitest.config.ts --reporter=verbose",
    "test:critical:bootstrap": "node infra/scripts/test-critical-bootstrap.mjs",
    "test:coverage": "vitest run --coverage --config vitest.config.ts --exclude 'tests/integration/database/**' --exclude 'tests/integration/factories.test.ts' --exclude 'tests/integration/db-schema.test.ts' --exclude 'tests/integration/foundational.test.ts' --exclude 'tests/integration/rls/rls-lgpd.test.ts' --exclude 'tests/integration/rls/rls-text-based-tables.test.ts' --exclude 'tests/integration/rls/rls-isolation.test.ts' --exclude 'tests/integration/webhook-persistence.test.ts' --exclude 'tests/integration/mfa/mfa-persistence.test.ts'",
    "test:e2e": "npx playwright test e2e/tests/fluxos-criticos.spec.ts --config playwright.config.ts",
    "test:e2e:spa": "bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts'",
    "test:e2e:spa:headed": "npx playwright test --config playwright-spa.config.ts --headed",
    "test:e2e:spa:docker": "bash infra/scripts/run-e2e-spa.sh",
    "test:e2e:spa:docker:keep": "bash infra/scripts/run-e2e-spa.sh --no-cleanup",
    "test:visual": "bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts -g \"Visual\"'",
    "test:visual:update": "bash -lc 'fuser -k 3111/tcp 3112/tcp 2>/dev/null || true; npx playwright test --config playwright-spa.config.ts -g \"Visual\" --update-snapshots'",
    "test:visual:headed": "npx playwright test --config playwright-spa.config.ts -g \"Visual\" --headed",
    "test:db:start": "docker compose -f docker-compose.test.yml up -d --force-recreate postgres-test",
    "test:db:stop": "docker compose -f docker-compose.test.yml down -v",
    "release:check": "pnpm typecheck && pnpm build && pnpm test:all",
    "bootstrap": "node infra/scripts/bootstrap-local.mjs",
    "staging:bootstrap": "node infra/scripts/bootstrap-local.mjs",
    "staging:check": "node infra/scripts/check-staging.mjs",
    "turbo:build": "PATH=./node_modules/.bin:.:$PATH turbo run build --filter=@cvg-his-v2/*",
    "turbo:typecheck": "PATH=./node_modules/.bin:.:$PATH turbo run typecheck --filter=@cvg-his-v2/*",
    "guardrail:ds-imports": "bash scripts/check-legacy-ds-imports.sh",
    "validate:openapi": "node scripts/validate-openapi.js"
  },
  "description": "Monorepo do sistema HIS veterinário versão 2, construido em padrão Enterprise.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardoakinaga-dev/cvg-his-v2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ricardoakinaga-dev/cvg-his-v2/issues"
  },
  "homepage": "https://github.com/ricardoakinaga-dev/cvg-his-v2#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.15.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3"
  }
}
