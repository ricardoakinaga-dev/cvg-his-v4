[Unit]
Description=CVG HIS V2 API
After=network.target postgresql.service redis.service

[Service]
Type=simple
WorkingDirectory=/opt/cvg-his-v2
EnvironmentFile=/opt/cvg-his-v2/.env.production
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3001
Environment=APP_NAME=cvg-his-v2-api
ExecStart=/usr/bin/node /opt/cvg-his-v2/apps/api/dist/index.js
Restart=always
RestartSec=5
RestartPreventExitStatus=1 2 3 4
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cvg-his-v2-api

[Install]
WantedBy=multi-user.target
