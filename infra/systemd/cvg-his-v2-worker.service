[Unit]
Description=CVG HIS V2 Worker
After=network.target postgresql.service cvg-his-v2-api.service

[Service]
Type=simple
WorkingDirectory=/opt/cvg-his-v2
EnvironmentFile=/opt/cvg-his-v2/.env.production
Environment=NODE_ENV=production
Environment=APP_NAME=cvg-his-v2-worker
ExecStart=/usr/bin/node /opt/cvg-his-v2/apps/worker/dist/index.js
Restart=always
RestartSec=5
RestartPreventExitStatus=1 2 3 4
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cvg-his-v2-worker

[Install]
WantedBy=multi-user.target
