# CVG-HIS V2 — Caddyfile
#
# FRONTEND CANONICO: apps/spa (SPA Vue/Pinia) — servico cvg-his-v2-spa
# his.domain.com -> SPA (porta 3002)
# his-api.domain.com -> API (porta 3003)
#
# Mapeamento de portas (docker-compose.v2.yml):
#   SPA:  3002:3002  — frontend canonico (apps/spa)
#   API:  3003:3001  — API do sistema
#
# Para atualizar a SPA apos mudancas de codigo:
#   1. Rebuild: docker compose build --no-cache cvg-his-v2-spa
#   2. Recriar: docker compose up -d --force-recreate cvg-his-v2-spa
#   3. Remover volume se necessario para evitar cache estatico stale:
#      docker rm -f cvg-his-v2-spa && docker volume rm cvg_his_v2_spa_static
#      docker compose up -d cvg-his-v2-spa
#   4. Validar: curl https://his.centroveterinarioguarapiranga.com/ e conferir a SPA

his.centroveterinarioguarapiranga.com {
  encode gzip
  reverse_proxy 127.0.0.1:3002
}

his-api.centroveterinarioguarapiranga.com {
  encode gzip
  reverse_proxy 127.0.0.1:3003
}
