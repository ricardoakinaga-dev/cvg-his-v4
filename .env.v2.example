NODE_ENV=production

# API
APP_NAME=cvg-his-v2-api
HOST=127.0.0.1
PORT=3001
CORS_ALLOWED_ORIGINS=https://his.example.com
# Only these proxy addresses/CIDRs may provide X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1
POSTGRES_DB=cvg_his_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_RUNTIME_USER=cvg_runtime
POSTGRES_RUNTIME_PASSWORD=troque-esta-senha-runtime
POSTGRES_API_USER=cvg_api
POSTGRES_API_PASSWORD=troque-esta-senha-api
POSTGRES_WORKER_USER=cvg_worker
POSTGRES_WORKER_PASSWORD=troque-esta-senha-worker
DATABASE_REQUIRE_RLS_ROLE=1
DATABASE_URL=postgres://cvg_api:troque-esta-senha-api@localhost:5432/cvg_his_v2
MIGRATION_DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/cvg_his_v2
# When running the canonical compose stack from the host, Redis is published
# on localhost:6380; containers use redis://redis:6379 internally.
REDIS_URL=redis://localhost:6380
# Production-like API instances must use the shared Redis backend; leave this
# enabled unless running an explicitly isolated development/test environment.
RUNTIME_DISTRIBUTED_STATE_ENABLED=1
WORKER_ACCOUNT_IDS=00000000-0000-0000-0000-000000000000

# Connection pool (applies when no external PgBouncer)
# POSTGRES_MAX_CONNECTIONS=20     # max pool size per API instance (default: 20)
# POSTGRES_POOL_MIN=2             # min idle connections in pool (default: 2)
# POSTGRES_IDLE_TIMEOUT_MS=30000  # idle connection TTL in ms (default: 30000)
# POSTGRES_CONNECTION_TIMEOUT_MS=5000  # connection acquire timeout in ms (default: 5000)

# PgBouncer (when using external pooler — set DATABASE_URL to pgbouncer:5432)
# PGBOUNCER_HOST=localhost
# PGBOUNCER_PORT=5432
# PGBOUNCER_POOL_MODE=transaction
# PGBOUNCER_MAX_CLIENT_CONN=1000

# CDN for static assets (SPA)
# VITE_CDN_BASE_URL=https://cdn.example.com  # CDN origin prefix for assets
# CDN_PROVIDER=cloudflare  # cloudflare | cloudfront | none (default: none)

# Gere com: openssl rand -hex 32
AUTH_SECRET=troque-por-um-segredo-forte-com-32-ou-mais-caracteres
# Token exigido pelo assistente de primeiro acesso (POST /auth/setup), que cria
# a clinica e o super administrador inicial. Se ficar vazio, o status continua
# disponivel, mas qualquer mutacao de setup falha fechada. Gere com
# `openssl rand -hex 32`; nunca registre o valor em logs, URLs ou tickets.
SETUP_BOOTSTRAP_TOKEN=
# Segredo compartilhado exigido no header x-webhook-secret do gateway WhatsApp.
WHATSAPP_WEBHOOK_SECRET=troque-por-um-segredo-independente

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
FILE_STORAGE_PATH=/tmp/cvg-his-v2-attachments
# Production-like environments require a reachable ClamAV daemon. Development
# uses the deterministic local scanner automatically.
ATTACHMENT_SCANNER_HOST=
ATTACHMENT_SCANNER_PORT=3310
ATTACHMENT_SCANNER_TIMEOUT_MS=5000
ATTACHMENT_STORAGE_S3_ENDPOINT=
ATTACHMENT_STORAGE_S3_BUCKET=
ATTACHMENT_STORAGE_S3_ACCESS_KEY=
ATTACHMENT_STORAGE_S3_SECRET_KEY=
ATTACHMENT_STORAGE_S3_REGION=us-east-1
ATTACHMENT_STORAGE_S3_PATH_STYLE=true
ENABLE_MFA=false
# Email transactional
EMAIL_FROM=noreply@example.com
EMAIL_MOCK_MODE=false
# RESEND_API_KEY=re_live_xxx

# Production-like environments require real outbound providers; mocks are for development/test only.
# PAGARME_API_KEY=
# PAGARME_PIX_KEY=
PIX_MOCK_MODE=false
# Synthetic PIX callback is an explicit local/test capability and must remain
# disabled in production-like environments. When enabled, provide an account-
# bound JSON keyring with canonical base64 secrets of at least 32 bytes.
PIX_SYNTHETIC_WEBHOOK_ENABLED=false
# PIX_WEBHOOK_KEYRING_JSON={"local-key-01":{"accountId":"00000000-0000-4000-8000-000000000000","secretBase64":"<base64-secret>"}}
# SMS_API_KEY=
SMS_MOCK_MODE=false
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_CALENDAR_ID=
GOOGLE_CALENDAR_MOCK_MODE=false
# MFA_SECRET_ENCRYPTION_KEY=12345678901234567890123456789012
# MFA_SECRET_ENCRYPTION_KEY_VERSION=2026-h1
# During rotation, retain older version->key pairs until credentials are re-encrypted.
# MFA_SECRET_ENCRYPTION_KEYRING_JSON={"2025-h2":"previous-key-at-least-16-characters"}
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cvg-his-v2-api
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# subir stack observability com: docker compose --profile observability up -d otel-collector prometheus grafana
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer token

# Worker
# para o container/servico worker, usar APP_NAME=cvg-his-v2-worker
WORKER_INTERVAL_MS=5000
WORKER_HEALTH_PORT=3002
# para o worker, usar OTEL_SERVICE_NAME=cvg-his-v2-worker
WORKER_OTEL_SERVICE_NAME=cvg-his-v2-worker

# Observability stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Backup operacional
BACKUP_BASE_DIR=/var/backups/cvg-his-v2
BACKUP_RETENTION_DAYS=7
BACKUP_INCLUDE_STORAGE=true

# SPA
VITE_APP_NAME=CVG HIS V2
# vazio = mesma origem; para subdominio dedicado, usar https://his-api.example.com
VITE_API_BASE_URL=
VITE_PROXY_API_TARGET=http://localhost:3001
VITE_DISABLE_PWA=1
